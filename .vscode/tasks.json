{
    "version": "2.0.0",
    // ==================== 换电脑时只需修改下面两项 ====================
    // 1. 修改为新电脑上 openocd.exe 的完整路径。
    "_PATH_OCD_EXE": "D:/STM32CubeIDE/STM32CubeIDE/plugins/com.st.stm32cube.ide.mcu.externaltools.openocd.win32_2.4.500.202604080855/tools/bin/openocd.exe",
    // 2. 修改为新电脑上 OpenOCD st_scripts 文件夹的完整路径。
    "_PATH_OCD_SCRIPTS": "D:/STM32CubeIDE/STM32CubeIDE/plugins/com.st.stm32cube.ide.mcu.debug.openocd_2.3.400.202606220929/resources/openocd/st_scripts",
    // 修改完成后运行 Generate openocd.cfg；下面任务中的路径和 ELF 文件名会自动同步，请勿逐项修改。
    "tasks": [
        {
            "label": "Generate openocd.cfg",
            "type": "shell",
            "command": "${workspaceFolder}/gen_openocd_cfg.bat",
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Configure",
            "type": "shell",
            "command": "cube-cmake",
            "args": [
                "--preset",
                "Debug"
            ],
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Build",
            "type": "shell",
            "command": "cube-cmake",
            "args": [
                "--build",
                "--preset",
                "Debug"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Flash (flash & reset, then exit OpenOCD)",
            "type": "shell",
            "dependsOn": "Stop OpenOCD",
            "command": "D:/STM32CubeIDE/STM32CubeIDE/plugins/com.st.stm32cube.ide.mcu.externaltools.openocd.win32_2.4.500.202604080855/tools/bin/openocd.exe",
            "args": [
                "-s",
                "D:/STM32CubeIDE/STM32CubeIDE/plugins/com.st.stm32cube.ide.mcu.debug.openocd_2.3.400.202606220929/resources/openocd/st_scripts",
                "-f",
                "${workspaceFolder}/openocd.cfg",
                "-c",
                "program build/Debug/FOC.elf verify reset exit"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "Build & Flash",
            "type": "shell",
            "dependsOn": [
                "Configure",
                "Build",
                "Stop OpenOCD"
            ],
            "dependsOrder": "sequence",
            "command": "D:/STM32CubeIDE/STM32CubeIDE/plugins/com.st.stm32cube.ide.mcu.externaltools.openocd.win32_2.4.500.202604080855/tools/bin/openocd.exe",
            "args": [
                "-s",
                "D:/STM32CubeIDE/STM32CubeIDE/plugins/com.st.stm32cube.ide.mcu.debug.openocd_2.3.400.202606220929/resources/openocd/st_scripts",
                "-f",
                "${workspaceFolder}/openocd.cfg",
                "-c",
                "program build/Debug/FOC.elf verify reset exit"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Start OpenOCD",
            "type": "shell",
            "command": "D:/STM32CubeIDE/STM32CubeIDE/plugins/com.st.stm32cube.ide.mcu.externaltools.openocd.win32_2.4.500.202604080855/tools/bin/openocd.exe",
            "args": [
                "-s",
                "D:/STM32CubeIDE/STM32CubeIDE/plugins/com.st.stm32cube.ide.mcu.debug.openocd_2.3.400.202606220929/resources/openocd/st_scripts",
                "-f",
                "${workspaceFolder}/openocd.cfg"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "Stop OpenOCD",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-NonInteractive",
                "-Command",
                "$process = Get-Process -Name openocd -ErrorAction SilentlyContinue; if ($process) { $process | Stop-Process -Force; Write-Host '[OK] OpenOCD stopped successfully.' } else { Write-Host '[OK] OpenOCD is not running.' }; exit 0"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}
